{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "items.schema.json",
  "title": "Items file (data/items/*.json)",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "type": { "enum": ["weapon_melee", "weapon_ranged", "ammo", "bomb", "key", "currency", "consumable", "quest", "heart"] },
          "stackable": { "type": "boolean", "default": false },
          "max_stack": { "type": "integer", "minimum": 1 },
          "stats": {
            "type": "object",
            "description": "Weapon stats. Damage is in enemy health points; ranged weapons name their ammo item id.",
            "properties": {
              "damage": { "type": "number", "minimum": 0 },
              "knockback": { "type": "number", "minimum": 0 },
              "cooldown": { "type": "number", "minimum": 0 },
              "ammo": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
