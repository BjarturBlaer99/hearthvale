{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "water_network.schema.json",
  "title": "Water network file (data/water/*.json)",
  "description": "Districts, basins, network nodes and interiors of one region (TECH_DESIGN §3.1). Levels go from MOST water to LEAST and water_height must strictly decrease; the runtime validator enforces that and every cross-reference.",
  "type": "object",
  "required": ["region"],
  "properties": {
    "region": { "type": "string", "minLength": 1 },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "levels", "start_level", "water_volume_per_step", "outflows"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "water_height"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "water_height": { "type": "integer", "minimum": 0, "maximum": 8 }
              }
            }
          },
          "start_level": { "type": "string", "description": "One of this district's level ids." },
          "water_volume_per_step": { "type": "integer", "minimum": 1, "description": "Whole units, so water is conserved exactly." },
          "outflows": {
            "type": "array",
            "description": "District or basin ids that overflow cascades into, in order.",
            "items": { "type": "string" }
          }
        }
      }
    },
    "basins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "capacity", "start_stored"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "capacity": { "type": "integer", "minimum": 0 },
          "start_stored": { "type": "integer", "minimum": 0, "description": "At most capacity." }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "district", "target", "start_state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["pump", "sluice", "outlet"] },
          "district": { "type": "string", "description": "District this node drains." },
          "target": { "type": "string", "description": "District or basin that receives the water." },
          "start_state": { "enum": ["broken", "repaired"] },
          "repair_requires": { "$ref": "conditions_and_effects.schema.json#/$defs/conditions" }
        }
      }
    },
    "interiors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "district"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "district": { "type": "string" },
          "dive_when": { "type": "array", "items": { "type": "string" }, "description": "Level ids where the interior loads underwater." },
          "dry_when": { "type": "array", "items": { "type": "string" }, "description": "Level ids where the interior loads dry." }
        }
      }
    }
  }
}
