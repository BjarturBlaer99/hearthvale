{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factions.schema.json",
  "title": "Factions and companions file (data/factions/*.json)",
  "type": "object",
  "properties": {
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "start_reputation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "start_reputation": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "faction_leaning", "start_approval"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "faction_leaning": { "type": "string", "description": "A faction id." },
          "start_approval": { "type": "integer", "minimum": -100, "maximum": 100 },
          "leaves_below": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    }
  }
}
