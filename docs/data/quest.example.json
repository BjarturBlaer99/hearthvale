{
  "id": "lost_key",
  "title": "The Lost Key",
  "giver": "village_elder",
  "start_stage": "find_key",
  "stages": {
    "find_key": {
      "journal": "The elder dropped the chapel key somewhere in the field.",
      "objectives": [
        { "id": "get_key", "text": "Find the chapel key",
          "complete_when": { "type": "has_item", "item": "small_key", "count": 1 } }
      ],
      "transitions": [
        { "when": { "type": "has_item", "item": "small_key", "count": 1 }, "to": "return_key" }
      ]
    },
    "return_key": {
      "journal": "Bring the key back to the elder.",
      "objectives": [
        { "id": "talk_elder", "text": "Return the key",
          "complete_when": { "type": "flag", "flag": "returned_chapel_key", "value": true } }
      ],
      "transitions": [
        { "when": { "type": "flag", "flag": "returned_chapel_key", "value": true }, "to": "done" }
      ]
    },
    "done": {
      "journal": "The elder has the chapel key again.",
      "on_enter": [
        { "type": "take_item", "item": "small_key", "count": 1 },
        { "type": "give_item", "item": "coin", "count": 20 },
        { "type": "complete_quest" }
      ]
    }
  },
  "_notes": "Example only (not loaded). Transitions are evaluated top to bottom; the first match wins. Flags like returned_chapel_key are set by dialogue effects."
}
