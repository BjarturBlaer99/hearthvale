{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conditions_and_effects.schema.json",
  "title": "Hearthvale condition and effect vocabulary",
  "description": "Shared by quests, dialogue, doors and world objects (see CONDITIONS_AND_EFFECTS.md). Editor/documentation aid: the authoritative check is autoload/data_registry.gd, which also resolves ids. Keep both in sync when adding a type.",
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "condition": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": { "type": { "const": "flag" }, "flag": { "$ref": "#/$defs/id" }, "value": {} },
          "required": ["flag", "value"]
        },
        {
          "properties": { "type": { "const": "has_item" }, "item": { "$ref": "#/$defs/id" }, "count": { "type": "integer", "minimum": 1 } },
          "required": ["item", "count"]
        },
        {
          "properties": { "type": { "const": "quest_stage" }, "quest": { "$ref": "#/$defs/id" }, "stage": { "$ref": "#/$defs/id" } },
          "required": ["quest", "stage"]
        },
        {
          "properties": { "type": { "const": "quest_status" }, "quest": { "$ref": "#/$defs/id" }, "status": { "enum": ["not_started", "active", "complete"] } },
          "required": ["quest", "status"]
        },
        {
          "properties": { "type": { "const": "days_since" }, "flag": { "type": "string", "minLength": 1 }, "days": { "type": "integer", "minimum": 1 } },
          "required": ["flag", "days"]
        },
        {
          "properties": { "type": { "enum": ["all", "any"] }, "of": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } },
          "required": ["of"]
        },
        {
          "properties": { "type": { "const": "not" }, "condition": { "$ref": "#/$defs/condition" } },
          "required": ["condition"]
        }
      ]
    },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
    "effect": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": { "type": { "const": "set_flag" }, "flag": { "$ref": "#/$defs/id" }, "value": {} },
          "required": ["flag", "value"]
        },
        {
          "properties": { "type": { "enum": ["give_item", "take_item"] }, "item": { "$ref": "#/$defs/id" }, "count": { "type": "integer", "minimum": 1 } },
          "required": ["item", "count"]
        },
        {
          "properties": { "type": { "const": "set_quest_stage" }, "quest": { "$ref": "#/$defs/id" }, "stage": { "$ref": "#/$defs/id" } },
          "required": ["quest", "stage"]
        },
        {
          "properties": { "type": { "const": "complete_quest" } }
        },
        {
          "properties": { "type": { "const": "sleep" } }
        },
        {
          "properties": { "type": { "const": "practise" }, "skill": { "type": "string", "minLength": 1 }, "deed": { "type": "string", "minLength": 1 } },
          "required": ["skill", "deed"]
        },
        {
          "properties": { "type": { "const": "shop" }, "shop": { "$ref": "#/$defs/id" }, "mode": { "enum": ["buy", "sell"] } },
          "required": ["shop", "mode"]
        }
      ]
    },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
  }
}
