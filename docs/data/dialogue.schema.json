{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue.schema.json",
  "title": "Dialogue file (data/dialogue/<id>.json, one conversation per file)",
  "description": "Node graph (TECH_DESIGN §7). Every option has 'next': a node id, or null to end the conversation. Options can be hidden by conditions and can apply effects.",
  "type": "object",
  "required": ["id", "start", "nodes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "start": { "type": "string", "description": "A key of 'nodes'." },
    "openings": {
      "type": "array",
      "description": "Optional: other nodes to begin at. The first whose conditions are all met is used in place of 'start'.",
      "items": {
        "type": "object",
        "required": ["conditions", "node"],
        "properties": {
          "conditions": { "$ref": "conditions_and_effects.schema.json#/$defs/conditions" },
          "node": { "type": "string", "description": "A key of 'nodes'." }
        }
      }
    },
    "speakers": {
      "type": "object",
      "description": "Optional: speaker id -> display name. A speaker missing here shows its id capitalised; an empty speaker (a sign) shows no name.",
      "additionalProperties": { "type": "string" }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["speaker", "text", "options"],
        "properties": {
          "speaker": { "type": "string" },
          "text": { "type": "string" },
          "on_enter": { "$ref": "conditions_and_effects.schema.json#/$defs/effects" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "next"],
              "properties": {
                "text": { "type": "string" },
                "conditions": { "$ref": "conditions_and_effects.schema.json#/$defs/conditions" },
                "effects": { "$ref": "conditions_and_effects.schema.json#/$defs/effects" },
                "next": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
