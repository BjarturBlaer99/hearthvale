            "of": [
              {
                "type": "flag",
                "flag": "built/coop",
                "value": true
              },
              {
                "type": "flag",
                "flag": "coop_shown_oda",
                "value": true
              }
            ]
          }
        },
        {
          "id": "tell",
          "text": "Tell Farmer Oda",
          "complete_when": {
            "type": "flag",
            "flag": "coop_shown_oda",
            "value": true
          }
        }
      ],
      "transitions": [
        {
          "when": {
            "type": "flag",
            "flag": "coop_shown_oda",
            "value": true
          },
          "to": "done"
        }
      ]
    },
    "done": {
      "journal": "Oda is glad your hens have a roof. He gave you sixty coins and five hay to start them on.",
      "on_enter": [
        {
          "type": "give_item",
          "item": "coin",
          "count": 60
        },
        {
          "type": "give_item",
          "item": "hay",
          "count": 5
        },
        {
          "type": "complete_quest"
        }
      ]
    }
  }
