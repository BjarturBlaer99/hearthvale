{
  "id": "a_roof_for_the_flock",
  "title": "A Roof for the Flock",
  "giver": "farmer_oda",
  "start_stage": "build",
  "stages": {
    "build": {
      "journal": "Farmer Oda would like to see hens kept on your farm, and they want a coop. Its plan is on the Build tab of your workbench.",
      "objectives": [
        {
          "id": "stands",
          "text": "Have a coop standing on your farm",
          "complete_when": {
