    "shuttle": {
      "speaker": "wenna",
      "text": "My best shuttle is gone. I was washing wool at the stream in the North Fields, on the far bank, and it must have slipped from my apron.",
      "options": [
        {
          "text": "I'll look for it.",
          "effects": [
            {
              "type": "set_quest_stage",
              "quest": "lost_shuttle",
              "stage": "find"
            }
          ],
          "next": "shuttle_go"
        },
        {
          "text": "Not now.",
          "next": null
        }
      ]
    },
    "shuttle_go": {
      "speaker": "wenna",
      "text": "Would you? It's boxwood, about so long. Over the bridge, then east along the bank.",
      "options": [
        {
          "text": "Is this it?",
          "conditions": [
            {
              "type": "quest_stage",
              "quest": "lost_shuttle",
              "stage": "return"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
