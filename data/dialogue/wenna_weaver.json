              "value": true
            }
          ],
          "next": "shuttle_done"
        },
        {
          "text": "Goodbye.",
          "next": null
        }
      ]
    },
    "shuttle_hint": {
      "speaker": "wenna",
      "text": "The far bank of the stream in the North Fields. Over the bridge, then east.",
      "options": [
        {
          "text": "Goodbye.",
          "next": null
        }
      ]
    },
    "shuttle_done": {
      "speaker": "wenna",
      "text": "That's it! Oh, bless you. Here, for your trouble.",
      "options": [
        {
          "text": "Goodbye.",
          "next": null
        }
      ]
    },
    "watch": {
      "speaker": "wenna",
      "text": "Did he now? Then take care on the north road. My brother saw lights there too.",
      "options": [
        {
          "text": "Goodbye.",
          "next": null
        }
      ]
    },
    "present": {
      "speaker": "wenna",
      "text": "This is for you: a little put by from the chapel cloth. Twenty-five coins. No, take it.",
      "on_enter": [
        {
          "type": "give_item",
          "item": "coin",
          "count": 25
        },
        {
          "type": "set_flag",
          "flag": "present/wenna",
          "value": true
        }
      ],
      "options": [
        {
          "text": "Thank you, Wenna.",
          "next": null
        }
      ]
    },
    "teach": {
      "speaker": "wenna",
      "text": "You're good company. Here is something my mother taught me: three handfuls of wild berries, boiled down slow. Berry jam. Try it at your hearth.",
      "on_enter": [
        {
          "type": "teach_recipe",
          "recipe": "berry_jam"
        }
      ],
      "options": [
        {
          "text": "Thank you.",
          "next": null
        }
      ]
    },
    "favour": {
      "speaker": "wenna",
      "text": "The chapel wants its cloth edged in black, and a good black dye starts with coal. Could you bring me five lumps from the Old Quarry?",
      "options": [
        {
          "text": "I'll bring it.",
          "effects": [
            {
              "type": "set_quest_stage",
              "quest": "black_for_the_loom",
              "stage": "bring"
            }
          ],
          "next": "favour_go"
        },
        {
          "text": "Not just now.",
          "next": "greet"
        }
      ]
    },
    "favour_go": {
      "speaker": "wenna",
      "text": "Bless you. They say the seam lies deep, below the copper. Mind yourself down there.",
      "options": [
        {
          "text": "Goodbye.",
          "next": null
        }
      ]
    },
    "favour_hint": {
      "speaker": "wenna",
      "text": "Five lumps of coal, for the black dye. The seam lies below the copper in the Old Quarry.",
      "options": [
        {
          "text": "Goodbye.",
          "next": null
        }
      ]
    },
    "favour_done": {
      "speaker": "wenna",
      "text": "Black as a crow's wing, it'll be. Here: thirty coins, and two cups of my blossom tea.",
      "options": [
        {
          "text": "Goodbye.",
          "next": null
        }
      ]
    }
