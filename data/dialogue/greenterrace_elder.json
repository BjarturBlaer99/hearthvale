          "success": "agree_evacuate", "failure": "refuse" },
        { "text": "Give them 20 food crates to start over.",
          "conditions": [{ "type": "has_item", "item": "food_crate", "count": 20 }],
          "effects": [{ "type": "take_item", "item": "food_crate", "count": 20 }],
          "next": "agree_evacuate" },
        { "text": "Leave.", "next": null }
      ]
