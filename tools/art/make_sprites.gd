func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(OUT_DIR)
	var failed: bool = false
	for sprite_name: String in SPRITES:
		failed = _paint(sprite_name, SPRITES[sprite_name]) != OK or failed
	quit(1 if failed else 0)


## Every frame of `sprite` by name, in the order they are painted: the drawn ones, then the
## ones made from them.
static func frames_of(sprite: Dictionary) -> Dictionary:
	var frames: Dictionary = (sprite["frames"] as Dictionary).duplicate()
	var made: Dictionary = sprite.get("made", {})
	for frame_name: String in made:
		var from: Array = frames[made[frame_name][0]]
		if made[frame_name][1] == "breathe":
			frames[frame_name] = sink(from, int(sprite["sink_row"]))
		else:
			frames[frame_name] = blink(from, str(sprite["lid"]), str(sprite["shut"]))
	return frames


## `rows` with everything above `row` a pixel lower, and that row gone: breathing out.
static func sink(rows: Array, row: int) -> Array:
	var out: Array = [".".repeat(str(rows[0]).length())]
	for y: int in rows.size():
		if y != row:
			out.append(rows[y])
	return out


## `rows` with the eyes closed: an eye pixel ("e") with more eye below it takes the `lid`
## colour, and the last row of each eye the `shut` one.
static func blink(rows: Array, lid: String, shut: String) -> Array:
	var out: Array = []
	for y: int in rows.size():
		var line: String = rows[y]
		var closed: String = ""
		for x: int in line.length():
			if line[x] != "e":
				closed += line[x]
			else:
				closed += lid if y + 1 < rows.size() and str(rows[y + 1])[x] == "e" else shut
		out.append(closed)
	return out


func _paint(sprite_name: String, sprite: Dictionary) -> Error:
	var size: Vector2i = sprite["size"]
	var frames: Dictionary = frames_of(sprite)
	var palette: Dictionary = sprite["palette"]
	var image: Image = Image.create(size.x * frames.size(), size.y * 2, false, Image.FORMAT_RGBA8)
	image.fill(Color(0, 0, 0, 0))
	var column: int = 0
	for frame_name: String in frames:
		var rows: Array = frames[frame_name]
		if rows.size() != size.y:
			push_error("tools/art: %s/%s has %d rows, not %d" % [sprite_name, frame_name, rows.size(), size.y])
			return ERR_INVALID_DATA
		for y: int in size.y:
			var line: String = rows[y]
			if line.length() != size.x:
				push_error("tools/art: %s/%s row %d is %d wide, not %d" % [sprite_name, frame_name, y, line.length(), size.x])
				return ERR_INVALID_DATA
			for x: int in size.x:
				var key: String = line[x]
				if key == ".":
					continue
				var shade: Color = OUTLINE if key == "o" else palette.get(key, Color.MAGENTA)
				if key != "o" and not palette.has(key):
					push_error("tools/art: %s/%s row %d has unknown colour '%s'" % [sprite_name, frame_name, y, key])
					return ERR_INVALID_DATA
				image.set_pixel(column * size.x + x, y, shade)
				image.set_pixel(column * size.x + x, size.y + y, Color.WHITE)
		column += 1
	# Art pass 3: warm the colours and soften the outlines of the painted row (not the flashes).
	PixelGrade.apply(image, OUTLINE, Rect2i(0, 0, image.get_width(), size.y), Vector2i.ZERO, MARKERS)
	var path: String = OUT_DIR.path_join(sprite_name + ".png")
	var error: Error = image.save_png(path)
	print("tools/art: %s, %d frames (%s)" % [path, frames.size(), error_string(error)])
	return error
