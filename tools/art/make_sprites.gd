func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(OUT_DIR)
	var failed: bool = false
	for sprite_name: String in SPRITES:
		failed = _paint(sprite_name, SPRITES[sprite_name]) != OK or failed
	quit(1 if failed else 0)


func _paint(sprite_name: String, sprite: Dictionary) -> Error:
	var size: Vector2i = sprite["size"]
	var frames: Dictionary = sprite["frames"]
	var palette: Dictionary = sprite["palette"]
	var image: Image = Image.create(size.x * frames.size(), size.y * 2, false, Image.FORMAT_RGBA8)
	image.fill(Color(0, 0, 0, 0))
	var column: int = 0
	for frame_name: String in frames:
		var rows: Array = frames[frame_name]
		if rows.size() != size.y:
			push_error("tools/art: %s/%s has %d rows, not %d" % [sprite_name, frame_name, rows.size(), size.y])
			return ERR_INVALID_DATA
		for y: int in size.y:
			var line: String = rows[y]
			if line.length() != size.x:
				push_error("tools/art: %s/%s row %d is %d wide, not %d" % [sprite_name, frame_name, y, line.length(), size.x])
				return ERR_INVALID_DATA
			for x: int in size.x:
				var key: String = line[x]
				if key == ".":
					continue
				var shade: Color = OUTLINE if key == "o" else palette.get(key, Color.MAGENTA)
				if key != "o" and not palette.has(key):
					push_error("tools/art: %s/%s row %d has unknown colour '%s'" % [sprite_name, frame_name, y, key])
					return ERR_INVALID_DATA
				image.set_pixel(column * size.x + x, y, shade)
				image.set_pixel(column * size.x + x, size.y + y, Color.WHITE)
		column += 1
	var path: String = OUT_DIR.path_join(sprite_name + ".png")
	var error: Error = image.save_png(path)
	print("tools/art: %s, %d frames (%s)" % [path, frames.size(), error_string(error)])
	return error
